// Starter config. We will extend it stage by stage.

manifest {
    name        = 'cancer-rnaseq-nextflow'
    description = 'Tumor vs normal RNA-seq: FastQC, fastp, Salmon, MultiQC, DESeq2, enrichment'
    mainScript  = 'main.nf'
    nextflowVersion = '!>=23.10.0'
}

params {
    samplesheet = null       // CSV: sample,patient,condition,fastq_1,fastq_2
    outdir      = 'results'
    transcripts = null       // GENCODE transcripts FASTA (.fa.gz)
    gtf         = null       // GENCODE annotation (.gtf.gz), used later for gene mapping
}

// Resource ceilings are deliberately modest so the pipeline runs on small machines.
process {
    cpus   = 2
    memory = 4.GB
    time   = 2.h

    // Building the human transcriptome index needs more memory than the default
    withName: 'SALMON_INDEX' {
        memory = 8.GB
        cpus   = 4
    }
}

profiles {

    // Use where Docker is available (laptop, Codespaces, cloud VM)
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Use on most HPC clusters: runs the same Docker images without root
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${HOME}/apptainer_cache"
    }

    // Submit each process as a SLURM job. Queue name is a placeholder: check your cluster docs.
    slurm {
        process.executor = 'slurm'
        process.queue    = 'short'
        executor.queueSize = 12     // at most 12 jobs at once
    }

    // One-command test run (defined fully in a later stage)
    test {
        // params.samplesheet = 'tests/samplesheet_test.csv'
    }
}
